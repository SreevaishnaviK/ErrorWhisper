rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global deny-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Common security helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Profile Validation
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'createdAt']) &&
        data.uid is string && data.uid.size() <= 128 &&
        data.email is string && data.email.size() <= 256 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    // Analysis Record Validation
    function isValidAnalysis(data) {
      return data.keys().hasAll(['id', 'userId', 'language', 'title', 'category', 'severity', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.language is string && data.language.size() <= 32 &&
        data.title is string && data.title.size() <= 256 &&
        data.category is string && data.category.size() <= 64 &&
        data.severity is string && data.severity.size() <= 32 &&
        (!('severityReason' in data) || (data.severityReason is string && data.severityReason.size() <= 1000)) &&
        (!('explanation' in data) || (data.explanation is string && data.explanation.size() <= 5000)) &&
        (!('likelyCause' in data) || (data.likelyCause is string && data.likelyCause.size() <= 2000)) &&
        (!('inputCode' in data) || (data.inputCode is string && data.inputCode.size() <= 10000)) &&
        (!('inputError' in data) || (data.inputError is string && data.inputError.size() <= 5000)) &&
        (!('correctedCode' in data) || data.correctedCode == null || (data.correctedCode is string && data.correctedCode.size() <= 10000)) &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    // User documents
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && incoming().uid == existing().uid && incoming().createdAt == existing().createdAt;
      allow delete: if false;

      // User's private analyses subcollection
      match /analyses/{analysisId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(analysisId) && incoming().userId == userId && isValidAnalysis(incoming());
        allow update: if isOwner(userId) && isValidId(analysisId) && incoming().userId == existing().userId && incoming().createdAt == existing().createdAt && isValidAnalysis(incoming());
        allow delete: if isOwner(userId) && isValidId(analysisId);
      }
    }
  }
}
