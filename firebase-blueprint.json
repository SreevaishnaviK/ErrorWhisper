{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 1024 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "AnalysisRecord": {
      "title": "AnalysisRecord",
      "description": "Persistent code analysis and error diagnosis record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "language": { "type": "string", "maxLength": 32 },
        "title": { "type": "string", "maxLength": 256 },
        "category": { "type": "string", "maxLength": 64 },
        "severity": { "type": "string", "maxLength": 32 },
        "severityReason": { "type": "string", "maxLength": 1000 },
        "explanation": { "type": "string", "maxLength": 5000 },
        "likelyCause": { "type": "string", "maxLength": 2000 },
        "inputCode": { "type": "string", "maxLength": 10000 },
        "inputError": { "type": "string", "maxLength": 5000 },
        "correctedCode": { "type": "string", "maxLength": 10000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "language", "title", "category", "severity", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document"
    },
    "/users/{userId}/analyses/{analysisId}": {
      "schema": "AnalysisRecord",
      "description": "Saved error diagnosis records for the user"
    }
  }
}
